{
  "manifest_version": 3,
  "name": "YouTube Productivity",
  "version": "1.0.0",
  "description": "A Chrome extension to reduce distractions on YouTube.",

  "icons": {
    "16": "assets/icons/brand/logo-16.png",
    "32": "assets/icons/brand/logo-32.png",
    "48": "assets/icons/brand/logo-48.png",
    "128": "assets/icons/brand/logo-128.png"
  },

  "action": {
    "default_popup": "popup/popup.html"
  },

  "background": {
        "service_worker": "service-worker.js"
  },

  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/page-script.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/features/featureHelpers.js",
      "content/features/home-feed.js",
      "content/features/shorts.js",
      "content/features/comments.js",
      "content/features/recommendations.js",
      "content/features/playlist.js",
      "content/features/endscreen.js",
      "content/features/live-chat.js",
      "content/features/mix.js",
      "content/features/notifications.js",
      "content/features/playables.js",
      "content/features/explore.js",
      "content/features/more-from-yt.js",
      "content/features/subscriptions.js",
      "content/features/search.js",
      "content/infiniteScrollingObserver.js",
      "content/observer.js",
      "content/content.js"
      ],
      "css": ["content/content.css"]
    }
  ]
}